generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String?
  password          String
  role              String    @default("user")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  videos            Video[]
  clips             Clip[]
  batches           Batch[]
  instagramConnections InstagramConnection[]
  jobLogs           JobLog[]
}

model Video {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  youtubeUrl      String
  title           String
  description     String?
  duration        Int?
  thumbnailUrl    String?
  filePath        String?
  status          String    @default("pending")
  fileSize        Int?
  resolution      String?
  fps             Float?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  clips           Clip[]
  batchItems      BatchItem[]
}

model Clip {
  id              String    @id @default(cuid())
  videoId         String
  video           Video     @relation(fields: [videoId], references: [id])
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  title           String
  description     String?
  filePath        String?
  duration        Int?
  startTime       Int?
  endTime         Int?
  status          String    @default("pending")
  fileSize        Int?
  instagramStatus String    @default("pending")
  instagramMediaId String?
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Batch {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  name            String
  status          String    @default("pending")
  scheduledAt     DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  items           BatchItem[]
}

model BatchItem {
  id              String    @id @default(cuid())
  batchId         String
  batch           Batch     @relation(fields: [batchId], references: [id])
  videoId         String
  video           Video     @relation(fields: [videoId], references: [id])
  clipId          String?
  status          String    @default("pending")
  order           Int
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model InstagramConnection {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  accessToken     String
  tokenType       String?
  expiresAt       DateTime?
  instagramUserId String?
  username        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model JobLog {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  jobId           String
  jobType         String
  status          String
  message         String?
  metadata        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
